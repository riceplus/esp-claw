# Anemoia ESP32-S3 N16R8 — 16 MB flash + 8 MB octal PSRAM
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash: 16 MB QIO 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Partition table: 16 MB layout (dual OTA + fatfs)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# PSRAM: 8 MB Octal 80 MHz (R8 variant). IGNORE_NOTFOUND keeps boot alive if a
# given unit has no PSRAM (falls back to SRAM-only, memory will be tight).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MEMTEST=n
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Audio: internal/dummy codec over I2S -> MAX98357
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y

# Display LCD support
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUB_SPI_SUPPORT=y

# LCD Touch (FT5x06 over I2C)
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUPPORT=y
CONFIG_ESP_BOARD_DEV_LCD_TOUCH_SUB_I2C_SUPPORT=y

# Audio codec (internal/dummy)
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y

# LEDC backlight control
CONFIG_ESP_BOARD_DEV_LEDC_CTRL_SUPPORT=y

# SD card (FAT on SPI)
CONFIG_ESP_BOARD_DEV_FS_FAT_SUPPORT=y
CONFIG_ESP_BOARD_DEV_FS_FAT_SUB_SPI_SUPPORT=y

# Amplifier SD pin (GPIO control)
CONFIG_ESP_BOARD_DEV_GPIO_CTRL_SUPPORT=y

# Peripheral support
CONFIG_ESP_BOARD_PERIPH_GPIO_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2C_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_LEDC_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_SPI_SUPPORT=y

# Console: UART0 (GPIO43/44, USB-TTL adapter). NOT USB Serial JTAG (pins unwired)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# FATFS: UTF-8 API encoding for Chinese filenames
CONFIG_FATFS_API_ENCODING_UTF_8=y
